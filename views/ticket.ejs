<%- include('partials/page-start', { pageTitle: 'Electronic Ticket' }) %>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card ticket-card shadow-lg">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div>
            <h1 class="h4 mb-1">Electronic Booth Ticket</h1>
            <p class="text-muted mb-0">Hong Kong Food Carnival</p>
          </div>
          <div class="text-end">
            <span class="badge bg-dark">Ticket ID</span>
            <div class="fs-5 fw-semibold"><%= booking.ticketCode %></div>
          </div>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Vendor</span>
              <span class="value"><%= booking.userId %></span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Booths Reserved</span>
              <% if (booths && booths.length) { %>
              <ul class="list-unstyled mb-0">
                <% booths.forEach((boothItem) => { %>
                <li>
                  <span class="value"><%= boothItem.label %></span>
                  <span class="text-muted small"> — <%= boothItem.theme %> • <%= boothItem.floorLabel || ('Floor ' + boothItem.floor) %></span>
                </li>
                <% }) %>
              </ul>
              <% } else { %>
              <span class="value">—</span>
              <% } %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Event</span>
              <span class="value"><%= event.title %></span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Venue</span>
              <span class="value"><%= event.venue %></span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Date &amp; Time</span>
              <span class="value"><%= event.date %>, <%= event.time %></span>
            </div>
          </div>
          <div class="col-md-6">
            <div class="ticket-field">
              <span class="label">Status</span>
              <span class="value text-success">Paid</span>
            </div>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-3">
          <div>
            <span class="label">Issued On</span>
            <div class="value"><%= new Date(booking.createdAt).toLocaleString() %></div>
          </div>
          <div class="text-end">
            <span class="label d-block">Amount</span>
            <div class="fs-4 fw-semibold">HK$<%= (booking.totalPrice || booking.price || 0).toLocaleString() %></div>
          </div>
        </div>
        <div class="alert alert-secondary mt-4 mb-0 small">
          Present this electronic ticket at the organizer counter on event day. A confirmation email has been sent to your registered address.
        </div>
      </div>
    </div>
    <div class="mt-3 text-center">
      <% if (booking && booking.id) { %>
      <a href="/ticket/<%= booking.id %>/qr" target="_blank" rel="noopener" class="btn btn-primary me-2">View QR</a>
      <% } %>
      <a href="/" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>
  </div>
</div>

<%- include('partials/page-end') %>

